# 本地 / 数据产物都不入库
.DS_Store
*.log

# 打包产物（数据永远留在远端 ceph，不进仓库）
*.tar.zst
*.tar.zst.part
*.tar.xz
*.manifest.txt
!docs/manifests/*.manifest.txt
*.zst

# Python（看板阶段会用到）
.venv/
__pycache__/
*.pyc
.pytest_cache/

# 看板运行时产物（数据由服务器生成，不入库）
dashboard/static/data.json
dashboard/static/data.json.gz
dashboard/cache/
dashboard/build/node_modules/
dashboard/build/.npm-cache/
dashboard/logs/

# 部署时预压缩产物
dashboard/static/**/*.gz

dashboard/static/samples.json
dashboard/static/samples.json.gz
