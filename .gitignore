# 本地 / 数据产物都不入库
.DS_Store
*.log

# 本地服务器清单（含主机、端口与密钥路径，不入库）
servers.conf

# 打包产物（数据永远留在远端 ceph，不进仓库）
*.tar.zst
*.tar.zst.part
*.tar.xz
*.manifest.txt
!docs/manifests/*.manifest.txt
*.zst

# Python（看板阶段会用到）
.venv/
__pycache__/
*.pyc
.pytest_cache/

# 看板运行时产物（数据由服务器生成，不入库）
dashboard/static/data.json
dashboard/static/data.json.gz
dashboard/static/data-*.json
dashboard/static/data-*.json.gz
dashboard/cache/
dashboard/build/node_modules/
dashboard/build/.npm-cache/
dashboard/logs/

# 部署时预压缩产物
dashboard/static/**/*.gz

dashboard/static/samples.json
dashboard/static/samples.json.gz
dashboard/static/samples-*.json
dashboard/static/samples-*.json.gz
dashboard/static/samples/

.taste-skill/
# 本地数据与服务状态（不入库）
dashboard/local_dev/server.pid
dashboard/*.pid
/datasets/

# 本地 Claude worktree 与会话产物（不入库）
.claude/
